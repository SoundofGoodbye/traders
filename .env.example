# traders local config — copy to .env (which is gitignored) and fill in.
# The CLI auto-loads ./.env at startup; run commands from the repo root.
# An exported environment variable always wins over a value here.

# Tiingo price source, used by `ingest-prices` (default source).
# Free API token: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# SEC EDGAR contact string, required for `--data-source edgar` (real name + email).
TRADERS_EDGAR_UA=you@example.com

# Anthropic API key, required for `--generator llm` and `eval-llm`.
ANTHROPIC_API_KEY=

# Optional: override the default Claude model for the LLM generators.
# TRADERS_LLM_MODEL=claude-sonnet-4-6
